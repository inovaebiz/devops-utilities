#!/bin/bash

# ==============================================================================
# Inovatils — Global CLI for Inova e-Business DevOps Utilities
#
# Maintainer: Inova e-Business
# Version: 1.0
#
# Purpose:
#   Thin wrapper that exposes the DevOps Utilities manager as a global command
#   `inovatils`, callable from any directory. It ensures the manager
#   (install.sh) is present in ~/.inova-devops and forwards all arguments to it.
#
# Supported platforms:
#   - Linux   : /usr/local/bin on PATH
#   - macOS   : /usr/local/bin on PATH (Homebrew-compatible)
#   - Windows : Git Bash / MSYS2 / WSL — /usr/local/bin inside that shell
#
# Usage:
#   inovatils                  # interactive menu
#   inovatils list             # list scripts and their status
#   inovatils install <script> # install a script
#   inovatils update           # update all installed scripts
#   inovatils self-update      # update the CLI + manager
#   inovatils --help           # show help
#
# Bootstrap (one-time install of the global command):
#   curl -fsSL https://raw.githubusercontent.com/inovaebiz/devops-utilities/main/install.sh | sudo bash -s -- inovatils
#   # or, if you already have install.sh locally:
#   sudo bash install.sh inovatils
# ==============================================================================

set -uo pipefail

VERSION="1.0"

REPO="inovaebiz/devops-utilities"
BRANCH="main"
RAW_URL="https://raw.githubusercontent.com/${REPO}/${BRANCH}"
STATE_DIR="${HOME}/.inova-devops"
MANAGER="${STATE_DIR}/install.sh"
BIN_TARGET="/usr/local/bin/inovatils"

# Colors (only when stdout is a terminal)
TTY=0
[ -t 1 ] && TTY=1
if [ "$TTY" = 1 ]; then
    C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_CYAN=$'\033[36m'
else
    C_RESET=""; C_BOLD=""; C_GREEN=""; C_RED=""; C_CYAN=""
fi

info() { printf '  %s[i]%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
err()  { printf '  %s✗%s %s\n' "$C_RED" "$C_RESET" "$*"; }

install_cli() {
    local target="${1:-$BIN_TARGET}" tmp
    tmp="$(mktemp)"
    info "Installing ${C_CYAN}${target}${C_RESET} ..."
    if ! curl -fsSL "${RAW_URL}/inovatils" -o "$tmp" 2>/dev/null; then
        err "Failed to download inovatils from ${RAW_URL}/inovatils"
        rm -f "$tmp"
        return 1
    fi
    if ! head -n1 "$tmp" | grep -q '^#!/'; then
        err "Downloaded file does not look like a shell script."
        rm -f "$tmp"
        return 1
    fi
    if mkdir -p "$(dirname "$target")" 2>/dev/null && [ -w "$(dirname "$target")" ]; then
        cp "$tmp" "$target" && chmod 755 "$target" || { err "Install failed."; rm -f "$tmp"; return 1; }
    else
        sudo mkdir -p "$(dirname "$target")" 2>/dev/null
        sudo cp "$tmp" "$target" && sudo chmod 755 "$target" || { err "Install failed (sudo may need your password)."; rm -f "$tmp"; return 1; }
    fi
    rm -f "$tmp"
    ok "Installed ${C_BOLD}inovatils${C_RESET} -> ${target}"
    info "Run ${C_BOLD}inovatils${C_RESET} from anywhere."
    return 0
}

ensure_manager() {
    if [ -f "$MANAGER" ]; then
        return 0
    fi
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    local tmp
    tmp="$(mktemp)"
    if ! curl -fsSL "${RAW_URL}/install.sh" -o "$tmp" 2>/dev/null; then
        err "Failed to download the manager from ${RAW_URL}/install.sh"
        rm -f "$tmp"
        return 1
    fi
    mv "$tmp" "$MANAGER" 2>/dev/null || cp "$tmp" "$MANAGER"
    chmod 750 "$MANAGER" 2>/dev/null || true
    rm -f "$tmp"
    return 0
}

# Direct install/update of the CLI itself (does not require the manager)
case "${1:-}" in
    install-cli|update-cli)
        install_cli "${2:-$BIN_TARGET}"
        exit $?
        ;;
    self-update)
        # Update both the wrapper (in /usr/local/bin) and the manager (in ~/.inova-devops)
        info "Updating ${C_BOLD}inovatils${C_RESET} ..."
        install_cli "$BIN_TARGET" || true
        info "Updating the manager ..."
        if ! ensure_manager; then
            err "Cannot update the manager."
            exit 1
        fi
        exec bash "$MANAGER" self-update
        ;;
    -h|--help|help)
        cat <<EOF
Inovatils v${VERSION} · ${REPO} (${BRANCH})

Usage:
  inovatils                          interactive menu
  inovatils list                     list scripts and their status
  inovatils status                   alias for "list"
  inovatils install <script>         install a script
  inovatils update                   update all installed scripts
  inovatils update <script>          update a specific script
  inovatils remove <script>          remove an installed script
  inovatils self-update              update the CLI + manager
  inovatils <script>                 shortcut: install <script>

Options:
  -h, --help                         show this help

Manager location: ${MANAGER}
CLI location:     ${BIN_TARGET}
EOF
        exit 0
        ;;
esac

if ! ensure_manager; then
    exit 1
fi

exec bash "$MANAGER" "$@"
